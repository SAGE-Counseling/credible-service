{
  "name": "sage/credible-service",
  "description": "Credible API integration package",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "SAGE Counseling, Inc.",
      "email": "info@sagecounseling.org"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "ext-soap": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Sage\\Credible\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sage\\Credible\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Sage\\Credible\\CredibleServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
